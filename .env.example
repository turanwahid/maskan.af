# Reference only — this project doesn't auto-load .env files (no dotenv
# dependency). Export these directly, or via your host's env var config:
#   JWT_SECRET=change-me PORT=3000 node server.js
# Without JWT_SECRET set, a dev-only default is used (see lib/auth.js) — always
# set a real one in production.
JWT_SECRET=change-me
PORT=3000
